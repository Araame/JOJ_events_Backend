# Configuration PostgreSQL pour JOJ_EVENT
DB_ENGINE=django.db.backends.postgresql
DB_NAME=joj_db // Nom de la base de données
DB_USER= "" // Nom de l'utilisateur
DB_PASSWORD="" // Mot de passe
DB_HOST=localhost //serveur
DB_PORT=5432

# Clé secrète Django (à ne jamais partager) qui se trouve dans settings que vous devez reprendre et ajouter dans votre fichier env
SECRET_KEY=django-insecure-"****************"

# Mode debug
DEBUG=True
# Configuration de mailtrip pour les notifications
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USE_TLS=True
EMAIL_HOST_USER=f******* //une fois que tu crées un compte sur mailtrap, un email host te sera donné que tu vas ajouter
EMAIL_HOST_PASSWORD=f***** //Le password sera également donné que tu vas ajouter
DEFAULT_FROM_EMAIL=JOJ Events <no-reply@joj-dakar-2026.sn> // Ici tu configures juste la réponse du mail de configuration
